# Copy to backend/.env and adjust. Never commit the real .env.

# Port the app (API + frontend) is served on.
PORT=4173

# How long a login session stays valid, in hours.
SESSION_TTL_HOURS=12

# Seed credentials, created on first run only. Change these before any real use.
ADMIN_EMAIL=admin@org.local
ADMIN_PASSWORD=Admin@123
PRESENTER_EMAIL=presenter@org.local
PRESENTER_PASSWORD=Present@123

# Max upload size for a single image, in megabytes.
MAX_UPLOAD_MB=32

# Max upload size for a single video, in megabytes.
MAX_VIDEO_MB=400

# Optional path to an ffmpeg binary. When available, MOV/AVI/MKV uploads are
# transcoded to MP4 (H.264/AAC) and a poster frame is extracted. Without it
# those files are stored and served unconverted, and the admin UI says so.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Show the demo credentials hint on the login screen (turn off for real presentations).
SHOW_LOGIN_HINT=true
