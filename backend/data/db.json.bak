vNpw-v8Q","height":"full","align":"right","overlay":60,"kicker":"SINCE [green-line:2016]","heading":"[green:TECHNICAL] [gold:HUB]","subheading":"[green:TECHNICAL] [gold:HUB] has established itself as one of India's leading industry-oriented skill development ecosystems, with a mission to bridge the gap between academia and industry. Since its inception in 2016, the organization has evolved into a comprehensive technology, innovation, certification, and career acceleration platform.","buttons":[]}],"createdAt":"2026-07-31T06:22:26.936Z","updatedAt":"2026-08-06T05:16:03.524Z","iconKey":"","iconAssetId":null},{"id":"sec_86a3d4d6212b4892","orgId":"technical-hub","parentId":"sec_8c7248a61dc04df1","key":"ceo-profile","title":"CEO Profile","subtitle":"","icon":"","iconKey":"user-badge","iconAssetId":null,"order":16,"hidden":false,"status":"published","blocks":[{"id":"blk_36c2f2fc4e0d4e9f","type":"leader-hero","layout":{"x":0,"y":0,"w":12,"h":15},"index":"01","kicker":"Founder & CEO · Technical Hub · Torii","firstName":"Babji","lastName":"Neelam","watermark":"Neelam","tagline":"Building skilled careers. Creating better tomorrows.","body":"Every engineer has a story. Mine runs from a small town in Andhra Pradesh, across three continents, and back home again — to build the bridge between campus and industry.","assetId":"ast_8089f55c901b4bf3","alt":"Babji Neelam, Founder & CEO of Technical Hub and Torii","tags":[{"label":"Change Maker","icon":"arrow-right","solid":false},{"label":"AI Innovator","icon":"sparkles","solid":true},{"label":"Problem Solver","icon":"target","solid":false},{"label":"Dream Big","icon":"arrow-up","solid":false},{"label":"Leave a Legacy","icon":"star","solid":false}],"links":[{"label":"LinkedIn","href":"https://www.linkedin.com/in/babjineelam/","icon":"linkedin"},{"label":"Instagram","href":"https://www.instagram.com/","icon":"instagram"},{"label":"YouTube","href":"https://www.youtube.com/","icon":"youtube"},{"label":"Facebook","href":"https://www.facebook.com/","icon":"facebook"}]}],"createdAt":"2026-08-06T10:50:26.888Z","updatedAt":"2026-08-06T11:15:47.839Z"},{"id":"sec_d2646548cb65432d","orgId":"technical-hub","parentId":"sec_8c7248a61dc04df1","key":"leadership-journey","title":"Leadership Journey","subtitle":"","icon":"","iconKey":"route","iconAssetId":null,"order":17,"hidden":false,"status":"published","blocks":[{"id":"blk_leadership_journey_7panels","type":"leadership-panels","layout":{"x":0,"y":0,"w":12,"h":15},"titleTop":"Leadership Journey","titleBottom":"Babji Neelam","tagline":"A Decade Covering 3 Continents","panels":[{"id":"engineer","icon":"cpu","title":"Enterprise Engineer","chapter":"The Foundation","year":"20XX","role":"Enterprise Systems Engineer","summary":"Where it began. He built the technical bedrock — architecting and scaling enterprise systems, and mastering the craft that every later chapter is built on.","quote":"Great systems are invisible — you only notice them when they hold.","highlights":["Architected resilient, enterprise-grade systems","Turned complex requirements into shipped software","Earned a name for solving what others couldn’t"]},{"id":"tech-leader","icon":"globe","title":"Global Technology Leader","chapter":"Scaling Up","year":"20XX","role":"Global Technology Leader","summary":"He stepped from building systems to building teams — leading technology across regions and setting direction at a global scale.","quote":"Leadership scales what talent alone can’t reach.","highlights":["Led cross-border engineering teams","Set technical strategy across markets","Delivered platforms serving users worldwide"]},{"id":"entrepreneur","icon":"lightbulb","title":"Visionary Entrepreneur","chapter":"The Leap","year":"20XX","role":"Founder & Entrepreneur","summary":"He traded a secure seat for a blank page — betting on a vision and turning it into a company.","quote":"The safest bet I made was on an idea nobody had funded yet.","highlights":["Spotted an unmet need in the market","Built the first product and the first team","Turned an idea into a going concern"]},{"id":"technical-hub","icon":"rocket","title":"Founder of TECHNICAL HUB","chapter":"The Flagship","year":"20XX","role":"Founder & CEO, TECHNICAL HUB","summary":"The centerpiece. He founded a place where talent is trained, technology is built, and opportunity is created at scale.","quote":"Build the place you wish had existed when you started.","highlights":["Established the company from the ground up","United training, product, and innovation under one roof","Created a launchpad for the next generation of engineers"]},{"id":"education","icon":"graduation-cap","title":"Education Innovator","chapter":"Teaching at Scale","year":"20XX","role":"Education Innovator","summary":"He reimagined how skills are taught — closing the gap between what students learn and what industry actually needs.","quote":"Teach the skill the market needs tomorrow, not the one it rewarded yesterday.","highlights":["Designed industry-aligned learning programs","Mentored thousands into careers in tech","Bridged the classroom-to-career divide"]},{"id":"ai","icon":"sparkles","title":"AI Transformation Leader","chapter":"The New Frontier","year":"20XX","role":"AI Transformation Leader","summary":"He put AI to work — transforming how organizations and learners operate in an intelligent-first world.","quote":"AI doesn’t replace people — it raises what people can do.","highlights":["Led AI adoption across products and teams","Reskilled the workforce for an AI era","Turned emerging tech into real outcomes"]},{"id":"impact","icon":"award","title":"Global Impact Creator","chapter":"The Legacy","year":"20XX","role":"Global Impact Creator","summary":"He measures success in lives changed — carrying the work beyond a single company toward lasting, global impact.","quote":"Measure a career by the doors it opens for others.","highlights":["Scaled impact across regions and communities","Built institutions that outlast any one project","Turned a career into a movement"]}]}],"createdAt":"2026-08-06T10:50:26.898Z","updatedAt":"2026-08-07T10:37:13.271Z"},{"id":"sec_28488e9d069c46e5","orgId":"technical-hub","parentId":"sec_8c7248a61dc04df1","key":"success-stories","title":"Success Stories","subtitle":"","icon":"","iconKey":"trophy","iconAssetId":null,"order":18,"hidden":false,"status":"published","blocks":[{"id":"blk_3c4fe790d7e24d70","type":"text","layout":{"x":0,"y":0,"w":12,"h":3},"heading":"What the bridge carries","level":2,"body":"Partnerships, infrastructure and placements that turn skilling into outcomes.","items":[],"align":"left"},{"id":"blk_2388e90480cf45ae","type":"cards","layout":{"x":0,"y":3,"w":12,"h":8},"variant":"plain","items":[{"id":"crd_fcbc1a21edf6494f","title":"Official Anthropic · Claude partner","subtitle":"Global partnership","meta":"","body":"900+ students through Anthropic courses · 10 Claude Certified Architects in-house.","imageAssetId":null,"tags":[]},{"id":"crd_afe4c30ea4ba4bd7","title":"NVIDIA DGX Spark on campus","subtitle":"AI infrastructure","meta":"","body":"200B-parameter models, run and fine-tuned locally.","imageAssetId":null,"tags":[]},{"id":"crd_933eb9f16c154039","title":"Project Space · Season 8","subtitle":"Events","meta":"","body":"A standing programme of student-built, AI-driven innovation projects.","imageAssetId":null,"tags":[]},{"id":"crd_d1c1a0af0adf4c52","title":"Cognizant · 2026 batch","subtitle":"Placements","meta":"","body":"Offers landing from the placement practice built into the programme.","imageAssetId":null,"tags":[]}]},{"id":"blk_02d1dad669894fdb","type":"text","layout":{"x":0,"y":11,"w":12,"h":3},"heading":"","level":3,"body":"Individual success stories open as their own pages — the navigation pane stays in place, so a story is one click away and so is the way back.","items":[],"align":"left"}],"createdAt":"2026-08-06T10:50:26.912Z","updatedAt":"2026-08-06T10:55:31.074Z"},{"id":"sec_6adc52eaddfa4292","orgId":"technical-hub","parentId":"sec_8c7248a61dc04df1","key":"ceo-vision","title":"CEO Vision","subtitle":"","icon":"","iconKey":"eye","iconAssetId":null,"order":19,"hidden":false,"status":"published","blocks":[{"id":"blk_ecd4b239491240dc","type":"quote","layout":{"x":0,"y":0,"w":12,"h":7},"text":"The students here are as good as any in the world. They don’t need charity — they need a bridge to industry. That is what we build, every single day.","author":"Babji Neelam","role":"Founder & CEO · Technical Hub · Torii","imageAssetId":null},{"id":"blk_7f11721b01774539","type":"cards","layout":{"x":0,"y":7,"w":12,"h":6},"variant":"plain","items":[{"id":"crd_7375485378e548ff","title":"Technical Hub","subtitle":"Skilling institute","meta":"","body":"The skilling arm of Aditya University — global certifications, placement practice and real products under one roof.","imageAssetId":null,"tags":[]},{"id":"crd_7e4eb4f0814a407f","title":"Torii · ToriiMinds","subtitle":"Scaling the model","meta":"","body":"Taking the proven campus model beyond one university to institutions across India.","imageAssetId":null,"tags":[]},{"id":"crd_eff06b4388bb413f","title":"Myna · Hoot · ATS","subtitle":"Products","meta":"","body":"Assessment and screening tools built in-house to measure real skill, not memorization.","imageAssetId":null,"tags":[]}]},{"id":"blk_f769304dc0f9476e","type":"text","layout":{"x":0,"y":13,"w":12,"h":2},"heading":"","level":3,"body":"Kakinada, Andhra Pradesh, India · Partnerships, speaking & skilling programs.","items":[],"align":"left"}],"createdAt":"2026-08-06T10:50:26.923Z","updatedAt":"2026-08-06T10:55:31.085Z"},{"id":"sec_0fbb02d2a502433f","orgId":"torii","parentId":"sec_bb70b38f2c3b4698","key":"ceo-profile","title":"CEO Profile","subtitle":"","icon":"","iconKey":"user-badge","iconAssetId":null,"order":16,"hidden":false,"status":"published","blocks":[{"id":"blk_9c831ad2de294f67","type":"leader-hero","layout":{"x":0,"y":0,"w":12,"h":15},"index":"01","kicker":"Founder & CEO · Technical Hub · Torii","firstName":"Babji","lastName":"Neelam","watermark":"Neelam","tagline":"Building skilled careers. Creating better tomorrows.","body":"Every engineer has a story. Mine runs from a small town in Andhra Pradesh, across three continents, and back home again — to build the bridge between campus and industry.","assetId":"ast_8089f55c901b4bf3","alt":"Babji Neelam, Founder & CEO of Technical Hub and Torii","tags":[{"label":"Change Maker","icon":"arrow-right","solid":false},{"label":"AI Innovator","icon":"sparkles","solid":true},{"label":"Problem Solver","icon":"target","solid":false},{"label":"Dream Big","icon":"arrow-up","solid":false},{"label":"Leave a Legacy","icon":"star","solid":false}],"links":[{"label":"LinkedIn","href":"https://www.linkedin.com/in/babjineelam/","icon":"linkedin"},{"label":"Instagram","href":"https://www.instagram.com/","icon":"instagram"},{"label":"YouTube","href":"https://www.youtube.com/","icon":"youtube"},{"label":"Facebook","href":"https://www.facebook.com/","icon":"facebook"}]}],"createdAt":"2026-08-06T11:15:47.864Z","updatedAt":"2026-08-06T11:15:47.864Z"},{"id":"sec_2939db9227084dae","orgId":"torii","parentId":"sec_bb70b38f2c3b4698","key":"leadership-journey","title":"Leadership Journey","subtitle":"","icon":"","iconKey":"route","iconAssetId":null,"order":17,"hidden":false,"status":"published","blocks":[{"id":"blk_leadership_journey_7panels","type":"leadership-panels","layout":{"x":0,"y":0,"w":12,"h":15},"titleTop":"Leadership Journey","titleBottom":"Babji Neelam","tagline":"A Decade Covering 3 Continents","panels":[{"id":"engineer","icon":"cpu","title":"Enterprise Engineer","chapter":"The Foundation","year":"20XX","role":"Enterprise Systems Engineer","summary":"Where it began. He built the technical bedrock — architecting and scaling enterprise systems, and mastering the craft that every later chapter is built on.","quote":"Great systems are invisible — you only notice them when they hold.","highlights":["Architected resilient, enterprise-grade systems","Turned complex requirements into shipped software","Earned a name for solving what others couldn’t"]},{"id":"tech-leader","icon":"globe","title":"Global Technology Leader","chapter":"Scaling Up","year":"20XX","role":"Global Technology Leader","summary":"He stepped from building systems to building teams — leading technology across regions and setting direction at a global scale.","quote":"Leadership scales what talent alone can’t reach.","highlights":["Led cross-border engineering teams","Set technical strategy across markets","Delivered platforms serving users worldwide"]},{"id":"entrepreneur","icon":"lightbulb","title":"Visionary Entrepreneur","chapter":"The Leap","year":"20XX","role":"Founder & Entrepreneur","summary":"He traded a secure seat for a blank page — betting on a vision and turning it into a company.","quote":"The safest bet I made was on an idea nobody had funded yet.","highlights":["Spotted an unmet need in the market","Built the first product and the first team","Turned an idea into a going concern"]},{"id":"technical-hub","icon":"rocket","title":"Founder of TECHNICAL HUB","chapter":"The Flagship","year":"20XX","role":"Founder & CEO, TECHNICAL HUB","summary":"The centerpiece. He founded a place where talent is trained, technology is built, and opportunity is created at scale.","quote":"Build the place you wish had existed when you started.","highlights":["Established the company from the ground up","United training, product, and innovation under one roof","Created a launchpad for the next generation of engineers"]},{"id":"education","icon":"graduation-cap","title":"Education Innovator","chapter":"Teaching at Scale","year":"20XX","role":"Education Innovator","summary":"He reimagined how skills are taught — closing the gap between what students learn and what industry actually needs.","quote":"Teach the skill the market needs tomorrow, not the one it rewarded yesterday.","highlights":["Designed industry-aligned learning programs","Mentored thousands into