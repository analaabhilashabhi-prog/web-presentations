# The frontend has no build step and no bundler, so it reads no environment
# variables at runtime. It is served by the backend and calls the API on the
# same origin under /api.
#
# This file exists to document that, and to hold values if a build step is
# introduced later.

# Base path for API calls. Only change this if the frontend is hosted
# separately from the backend (it would then also need CORS enabled server-side).
API_BASE=/api
